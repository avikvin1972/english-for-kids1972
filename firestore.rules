rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Тестовая коллекция для проверки связки
    match /connectionTest/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Прогресс ребёнка по темам — каждый видит и пишет только свой профиль
    match /progress/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
